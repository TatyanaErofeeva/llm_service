APP_ENV=dev
LOG_LEVEL=INFO

# Обязательно: ключ OpenAI-совместимого API (не коммитьте реальный ключ)
LLM_API_KEY=your_api_key_here

# Базовый URL без завершающего слэша; путь /chat/completions добавит клиент
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=15.0
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1.0

# TTL in-memory кеша в секундах
CACHE_TTL_SECONDS=300
